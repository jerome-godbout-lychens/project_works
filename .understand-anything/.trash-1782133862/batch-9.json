    {
      "id": "file:backend/cmd/integration-test/main.go",
      "type": "file",
      "name": "main.go",
      "filePath": "backend/cmd/integration-test/main.go",
      "summary": "Standalone end-to-end integration test harness that drives the running backend's HTTP API, exercising the full lifecycle of projects, elements, links, attachments, versions, phases, custom fields, groups/access, and auth, then emits a markdown test report.",
      "tags": ["test", "integration-test", "entry-point", "api-handler", "test-harness"],
      "complexity": "complex",
      "languageNotes": "Single-package Go binary using net/http directly (no test framework); a testContext struct carries the HTTP client, API key, and accumulated results, with helper request/assert methods replacing testing.T."
    },
    {
      "id": "service:Dockerfile_tests",
      "type": "service",
      "name": "Dockerfile_tests",
      "filePath": "Dockerfile_tests",
      "summary": "Builds the test container image from golang:1.26-alpine, installing just/gotestsum and tooling, then compiling the integration-test binary used to run unit and integration tests in CI and locally.",
      "tags": ["containerization", "infrastructure", "test", "build-system"],
      "complexity": "simple",
      "languageNotes": "Single-stage Alpine build that installs the just task runner and gotestsum, then statically compiles the integration-test binary with CGO_ENABLED=0."
    },
    {
      "id": "file:justfile",
