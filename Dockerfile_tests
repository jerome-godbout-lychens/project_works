FROM golang:1.26-alpine

RUN apk add --no-cache \
  git \
  ca-certificates \
  tzdata \
  jq \
  sed \
  just \
  bash

RUN go install gotest.tools/gotestsum@latest

WORKDIR /app

COPY backend/go.mod backend/go.sum* ./
RUN go mod download

COPY backend/ .
COPY justfile ./
COPY TestsResultsParser.sh ./

RUN go mod tidy

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/project-works-integration-test ./cmd/integration-test

ENTRYPOINT ["/bin/bash"]
